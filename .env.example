# ─────────────────────────────────────────────────────────────
#  OBSYDIA AI — environment configuration
#  Copy to .env and fill in the values. Never commit .env.
#  The VPS installer creates .env automatically and never
#  overwrites values that are already set.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=8080
APP_NAME=OBSYDIA AI
APP_CREATOR=Inconnu Boy Sensei
APP_EMAIL=inconnuboytech@gmail.com
APP_URL=https://your-domain.com
# Extra allowed browser origins, comma separated (optional)
CORS_ORIGINS=
# Number of reverse proxies in front of the app (Caddy = 1, Render = 1)
TRUST_PROXY=1
# Persistent storage for uploads and ZIP artifacts
DATA_DIR=./data
# Optional separate origin for project previews (e.g. https://preview.your-domain.com)
PREVIEW_URL=

# ── AI identity (admins can override these from the dashboard) ──
AI_DISPLAY_NAME=OBSYDIA
AI_PERSONALITY=Professional, intelligent, friendly, precise and technically advanced.
# Multiline prompts: use \n for line breaks, or wrap in double quotes
AI_SYSTEM_PROMPT="You are OBSYDIA AI, an advanced AI assistant created by Inconnu Boy Sensei. You help with programming, development, research, explanations and project generation. Be professional, accurate and helpful. When asked who created you, identify Inconnu Boy Sensei as your creator."
AI_WELCOME_MESSAGE=Welcome to OBSYDIA AI. What would you like to create today?
AI_DEFAULT_LANGUAGE=auto
AI_MAX_OUTPUT_TOKENS=4096
AI_PROJECT_MAX_OUTPUT_TOKENS=16000
AI_CONTEXT_MESSAGES=24

# ── AI provider (OpenAI-compatible) ──
# DeepSeek by default. deepseek-v4-flash = fast, strong and cheap; thinking is disabled to save tokens.
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
# Additional selectable models, comma separated (optional), e.g. deepseek-v4-pro
AI_MODELS=
# Unlimited authorized keys, JSON array: ["sk-...","sk-..."]
# More keys can be added (encrypted) from Administration → Provider keys.
AI_API_KEYS=[]
AI_TIMEOUT_MS=120000
AI_MAX_RETRIES=3
# Extra JSON fields sent with every request (empty = provider default; DeepSeek: {"thinking":{"type":"disabled"}})
AI_EXTRA_BODY=
# Hard cap on max_tokens if the model has one (0 = none)
AI_MAX_OUTPUT_CAP=0
# Only enable after verifying the model supports them
AI_SUPPORTS_VISION=false
AI_SUPPORTS_AUDIO=false
AI_SUPPORTS_TOOLS=true

# ── Speech-to-text (optional, OpenAI-compatible /audio/transcriptions) ──
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1

# ── Database ──
# Docker Compose builds MONGODB_URI from MONGO_ROOT_USER / MONGO_ROOT_PASSWORD.
# For Render or an external cluster (MongoDB Atlas), set MONGODB_URI directly.
MONGODB_URI=
MONGO_ROOT_USER=obsydia
MONGO_ROOT_PASSWORD=
MONGO_CACHE_GB=0.5
# Optional: shared rate-limit store (docker compose --profile redis)
REDIS_URL=

# ── Secrets (generate with: openssl rand -hex 32) ──
JWT_SECRET=
SESSION_SECRET=
ENCRYPTION_KEY=
SESSION_TTL_DAYS=30

# ── Initial administrator (created at first start if it does not exist) ──
ADMIN_EMAIL=inconnuboytech@gmail.com
ADMIN_PASSWORD=

# ── Email (Gmail: smtp.gmail.com, port 587, use an App Password) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=inconnuboytech@gmail.com

# ── Google sign-in (optional) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Stripe ──
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── PayPal ──
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
PAYPAL_PLAN_ID_PRO=
PAYPAL_PLAN_ID_PREMIUM=

# ── Domain & HTTPS (VPS) ──
DOMAIN=
ACME_EMAIL=inconnuboytech@gmail.com

# ── Plans & tokens ──
FREE_TOKEN_LIMIT=25000
FREE_TOKEN_RESET_HOURS=168
PRO_TOKEN_LIMIT=60000
PRO_TOKEN_RESET_HOURS=7
PREMIUM_TOKEN_LIMIT=300000
PREMIUM_TOKEN_RESET_HOURS=7
PRO_PRICE_USD=1.99
PREMIUM_PRICE_USD=5.00

REFERRAL_REQUIRED=5
REFERRAL_REWARD_TOKENS=10000
MAX_TEAM_INVITES=3

# ── Ads (editable in Administration → Ads). Premium/Custom plans and admins see no ads ──
ADS_ENABLED=true
ADS_NATIVE_SRC=https://bauval.org/21/1878ebe128fe0761e5ff5020fec7ca27
ADS_NATIVE_CONTAINER=container-1878ebe128fe0761e5ff5020fec7ca27
ADS_SOCIAL_SRC=https://bauval.org/14/6320fb17b3cd656cecaddc32d0d5f525
ADS_SMARTLINK=https://araplhn.org/4/ad3d00b332f1ab51b420a41cea657ee5
ADS_SOCIAL_DELAY_SECONDS=20
ADS_FREE_PLANS=premium,custom

# ── Limits ──
MAX_UPLOAD_MB=25
MAX_ZIP_ENTRIES=2000
MAX_ZIP_UNCOMPRESSED_MB=200
ARTIFACT_LINK_TTL_MINUTES=15
PREVIEW_LINK_TTL_MINUTES=60
