# ============================================================
#  INCONNU SMS — environment configuration
#  Copy to .env. NEVER commit real secrets. deploy.sh generates
#  this file automatically with strong random values.
# ============================================================

# Public URL of the site (https://… in production — enables Secure cookies)
APP_URL=http://localhost:3000
# Domain used by Nginx / Let's Encrypt (docker)
DOMAIN=localhost

# Secrets (min 32 random chars). ENCRYPTION_KEY encrypts provider/Stripe keys
# stored from the admin panel (AES-256-GCM) — do not change it after install.
APP_SECRET=change_me_to_a_long_random_string
ENCRYPTION_KEY=change_me_to_another_long_random_string
# Protects /api/cron/sync (called by the worker)
CRON_SECRET=change_me_cron_secret

# --- Database -------------------------------------------------
# Local dev: full URL. Docker: built from POSTGRES_* in docker-compose.yml
DATABASE_URL=postgresql://inconnu:inconnu@localhost:5432/inconnu_sms?schema=public
POSTGRES_USER=inconnu
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=inconnu_sms

# Optional — enables multi-instance rate limiting (set automatically in docker)
REDIS_URL=

# --- Super admin created automatically by the seeder (once) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe12345
ADMIN_NAME=Inconnu Boy Sensei

# --- Providers --------------------------------------------------
# DEMO provider (simulated numbers) enabled on first install
DEMO_PROVIDER=true
# Real provider keys: PROVIDER_<CODE>_API_KEY (takes precedence over the admin field)
# PROVIDER_MYSUPPLIER_API_KEY=

# --- Stripe (or configure in Admin → Settings & Stripe) ---------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- SMTP (optional) — without it, emails are logged in Admin → System logs
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=INCONNU SMS <no-reply@example.com>
